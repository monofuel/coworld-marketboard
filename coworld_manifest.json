{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "game": {
    "name": "marketboard",
    "version": "0.1.0",
    "description": "A cooperative/competitive economy simulation where gatherers and crafters trade on a player-driven market.",
    "owner": "monofuel",
    "runnable": {
      "type": "game",
      "image": "ghcr.io/metta-ai/coworld-marketboard:latest",
      "run": ["/bin/marketboard", "--address:0.0.0.0", "--port:8080"]
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player slot, indexed by slot.",
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 0
          },
          "default": []
        },
        "seed": {
          "description": "Random seed for world generation.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maxTicks": {
          "description": "Maximum simulation ticks before shutdown, where 0 means no tick limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maxGames": {
          "description": "Maximum games before shutdown, where 0 means no game limit.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gold": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "totalWealth": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "marketCap": {
          "type": "integer"
        }
      }
    },
    "protocols": {
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      },
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      }
    }
  },
  "player": [
    {
      "id": "still_forge",
      "name": "Still Forge",
      "description": "Specialist strategy bot — picks one role and trades at fair prices.",
      "runnable": {
        "type": "player",
        "image": "ghcr.io/metta-ai/coworld-marketboard-still-forge:latest",
        "run": ["/bin/still_forge"]
      }
    }
  ],
  "variants": [
    {
      "id": "freeplay",
      "name": "Freeplay",
      "game_config": {
        "seed": 0,
        "maxTicks": 0,
        "maxGames": 0
      },
      "description": "Open-ended Marketboard for local testing and human play."
    },
    {
      "id": "smoke",
      "name": "Smoke",
      "game_config": {
        "seed": 42,
        "maxTicks": 500,
        "maxGames": 1
      },
      "description": "Short deterministic run for manifest checks and CI."
    }
  ],
  "certification": {
    "variant_id": "smoke",
    "players": [
      { "player_id": "still_forge", "initial_params": { "name": "Forge1" } },
      { "player_id": "still_forge", "initial_params": { "name": "Forge2" } },
      { "player_id": "still_forge", "initial_params": { "name": "Forge3" } },
      { "player_id": "still_forge", "initial_params": { "name": "Forge4" } },
      { "player_id": "still_forge", "initial_params": { "name": "Forge5" } },
      { "player_id": "still_forge", "initial_params": { "name": "Forge6" } }
    ]
  }
}
